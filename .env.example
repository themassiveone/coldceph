# Copy to .env and edit. docker compose loads .env automatically.
# Every value below is already the compose/launchSettings default.

# --- Ceph (docker compose) ---
CEPH_IMAGE=quay.io/ceph/daemon:v7.0.3-stable-7.0-quincy-centos-stream8
CEPH_CONTAINER_NAME=coldceph-ceph
CEPH_HOSTNAME=ceph
NETWORK_AUTO_DETECT=0
CEPH_IPV4=172.28.90.10
CEPH_PUBLIC_NETWORK=172.28.90.0/24
CEPH_NETWORK_NAME=coldceph_ceph
DEMO_DAEMONS=mon,mgr,osd,rgw
CEPH_DEMO_UID=coldceph
CEPH_DEMO_ACCESS_KEY=coldceph
CEPH_DEMO_SECRET_KEY=coldcephsecret
CEPH_DEMO_BUCKET=cold
RGW_CIVETWEB_PORT=8080
RGW_HOST_PORT=7481
RGW_NAME=localhost
MON_HOST_PORT=3300
CEPH_DASHBOARD=0

# --- Control (IDE launchSettings / process env) ---
WEB_PORT=8080
S3_PORT=7480
COLDCEPH_RGW=http://127.0.0.1:7481
COLDCEPH_CEPH_BINARY=docker/ceph/ceph
COLDCEPH_OPERATOR_PASSWORD=changeme
COLDCEPH_NODE_TOKEN=changeme
COLDCEPH_NODE_HOST_ID=dev

# --- Node (IDE launchSettings / process env) ---
NODE_PORT=7080
COLDCEPH_HOST_ID=dev
COLDCEPH_HOSTNAME=dev
COLDCEPH_CONTROL_ENDPOINT=http://127.0.0.1:8080
COLDCEPH_ADVERTISE_URL=http://127.0.0.1:7080
