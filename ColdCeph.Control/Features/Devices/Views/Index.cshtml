@using ColdCeph.Control.Features.Devices.ViewModels
@using ColdCeph.Core.Features.Devices.DTOs
@model DevicesPageViewModel
@{
    ViewData["Title"] = "Devices";
}
<p class="cc-page-kicker">Disks</p>
<h1>Disk details</h1>
<p class="cc-lead">Identity and power details for replacing or troubleshooting a physical disk.</p>
<section class="cc-card">
    @if (Model.Errors.Count > 0)
    {
        <ul class="cc-empty">
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    }
    @if (Model.Devices.Count == 0)
    {
        <p class="cc-empty">No drives reported. Allowed Nodes push inventory when they see local disks.</p>
    }
    else
    {
        <div class="cc-table-wrap">
            <table class="cc-table">
                <thead>
                    <tr>
                        <th>Device</th>
                        <th>Host</th>
                        <th>OSD</th>
                        <th>Power</th>
                        <th>Identity</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var device in Model.Devices)
                {
                    <tr>
                        <td class="cc-mono">@device.DeviceId</td>
                        <td>@device.HostId</td>
                        <td>@(device.MappedOsdId is int osd ? $"osd.{osd}" : "—")</td>
                        <td>
                            @{
                                var power = device.PowerState.ToString();
                            }
                            <span class="cc-chip @(device.PowerState == DevicePowerState.Active ? "cc-chip-ok" : device.PowerState == DevicePowerState.Standby ? "cc-chip-idle" : "cc-chip-busy")">@power</span>
                        </td>
                        <td class="cc-mono">@(device.Serial ?? device.Wwn ?? device.Path ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
