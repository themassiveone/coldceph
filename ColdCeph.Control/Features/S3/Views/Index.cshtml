@using ColdCeph.Core.Features.S3.DTOs
@model S3PendingWorkDto
@{
    ViewData["Title"] = "Backup traffic";
}
<p class="cc-page-kicker">Advanced</p>
<h1>Backup traffic</h1>
<p class="cc-lead">Current client requests using the cold-storage S3 endpoint.</p>
<section class="cc-card">
    <h2>Current work</h2>
    <dl class="cc-dl">
        <dt>Pending work</dt>
        <dd>@(Model.HasPendingWork ? "yes" : "no")</dd>
        <dt>Active</dt>
        <dd>@Model.ActiveCount</dd>
        <dt>Queued</dt>
        <dd>@Model.QueuedCount</dd>
        <dt>Last activity</dt>
        <dd>@(Model.LastActivity?.ToString("u") ?? "none")</dd>
    </dl>
</section>
