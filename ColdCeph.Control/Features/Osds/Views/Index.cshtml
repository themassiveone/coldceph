@using ColdCeph.Control.Features.Osds.ViewModels
@model OsdsPageViewModel
@{
    ViewData["Title"] = "OSDs";
}
<p class="cc-page-kicker">OSDs</p>
<h1>OSD processes</h1>
<p class="cc-lead">Nodes push local process state. Up/in is overlaid from Ceph.</p>
<section class="cc-card">
    @if (Model.Errors.Count > 0)
    {
        <ul class="cc-empty">
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    }
    @if (Model.Osds.Count == 0)
    {
        <p class="cc-empty">No OSDs reported. Allowed Nodes push inventory when they see local OSD processes.</p>
    }
    else
    {
        <div class="cc-table-wrap">
            <table class="cc-table">
                <thead>
                    <tr>
                        <th>OSD</th>
                        <th>Host</th>
                        <th>Process</th>
                        <th>Ceph</th>
                        <th>Device</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var osd in Model.Osds)
                {
                    <tr>
                        <td class="cc-mono">osd.@osd.OsdId</td>
                        <td>@osd.HostId</td>
                        <td>
                            @if (osd.ProcessRunning)
                            {
                                <span class="cc-chip cc-chip-ok">running</span>
                            }
                            else
                            {
                                <span class="cc-chip cc-chip-idle">stopped</span>
                            }
                        </td>
                        <td>@(osd.Up ? "up" : "down") / @(osd.In ? "in" : "out")</td>
                        <td class="cc-mono">@(osd.DeviceId ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
