@using ColdCeph.Core.Features.Osds.DTOs
@model IReadOnlyList<OsdDto>
@{
    ViewData["Title"] = "OSDs";
}
<p class="cc-page-kicker">OSDs</p>
<h1>OSD processes</h1>
<p class="cc-lead">Up/in is Ceph. Running is the process ColdCeph asked the Node to start or stop.</p>
<section class="cc-card">
    @if (Model.Count == 0)
    {
        <p class="cc-empty">No OSDs yet. Enroll a Node, then wake the plane so inventory can show up.</p>
    }
    else
    {
        <div class="cc-table-wrap">
            <table class="cc-table">
                <thead>
                    <tr>
                        <th>OSD</th>
                        <th>Host</th>
                        <th>Process</th>
                        <th>Ceph</th>
                        <th>Device</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var osd in Model)
                {
                    <tr>
                        <td class="cc-mono">osd.@osd.OsdId</td>
                        <td>@osd.HostId</td>
                        <td>
                            @if (osd.ProcessRunning)
                            {
                                <span class="cc-chip cc-chip-ok">running</span>
                            }
                            else
                            {
                                <span class="cc-chip cc-chip-idle">stopped</span>
                            }
                        </td>
                        <td>@(osd.Up ? "up" : "down") / @(osd.In ? "in" : "out")</td>
                        <td class="cc-mono">@(osd.DeviceId ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
