@model ColdCeph.Control.Features.Hosts.ViewModels.HostsPageViewModel
@{
    ViewData["Title"] = "Storage";
}
<p class="cc-page-kicker">Storage</p>
<h1>Storage machines</h1>
<p class="cc-lead">Approve machines you recognize and check that every enrolled machine is online.</p>

<section class="cc-card">
    <h2>Waiting to join</h2>
    @if (Model.Pending.Count == 0)
    {
        <p class="cc-empty">No machines are waiting for approval.</p>
    }
    else
    {
        <div class="cc-table-wrap">
            <table class="cc-table">
                <thead>
                    <tr>
                        <th>Host</th>
                        <th>Endpoint</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var request in Model.Pending)
                {
                    <tr>
                        <td>@request.Hostname</td>
                        <td class="cc-mono">@request.Endpoint</td>
                        <td>
                            <div class="cc-row-actions">
                                <form method="post" action="/hosts/@request.HostId/approve">
                                    @Html.AntiForgeryToken()
                                    <button class="cc-btn cc-btn-primary" type="submit">Allow</button>
                                </form>
                                <form method="post" action="/hosts/@request.HostId/deny">
                                    @Html.AntiForgeryToken()
                                    <button class="cc-btn cc-btn-danger" type="submit">Deny</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="cc-card">
    <h2>Enrolled</h2>
    @if (Model.Enrolled.Count == 0)
    {
        <p class="cc-empty">No storage machines are connected. Check that ColdCeph Node is running on each storage machine.</p>
    }
    else
    {
        <div class="cc-table-wrap">
            <table class="cc-table">
                <thead>
                    <tr>
                        <th>Host</th>
                        <th>Liveness</th>
                        <th>Endpoint</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var host in Model.Enrolled)
                {
                    <tr>
                        <td>@host.Hostname</td>
                        <td>
                            @if (host.Alive)
                            {
                                <span class="cc-chip cc-chip-ok">alive</span>
                            }
                            else
                            {
                                <span class="cc-chip cc-chip-busy">stale</span>
                            }
                        </td>
                        <td class="cc-mono">@host.Endpoint</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.Blocked.Count > 0)
{
    <section class="cc-card">
        <h2>Blocked</h2>
        <div class="cc-table-wrap">
            <table class="cc-table">
                <thead>
                    <tr>
                        <th>Host</th>
                        <th>Endpoint</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var request in Model.Blocked)
                {
                    <tr>
                        <td>@request.Hostname</td>
                        <td class="cc-mono">@request.Endpoint</td>
                        <td>
                            <form method="post" action="/hosts/@request.HostId/approve">
                                @Html.AntiForgeryToken()
                                <button class="cc-btn cc-btn-primary" type="submit">Allow</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
