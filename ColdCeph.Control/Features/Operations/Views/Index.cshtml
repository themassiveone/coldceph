@using ColdCeph.Core.Features.Operations.DTOs
@model IReadOnlyList<OperationRecordDto>
@{
    ViewData["Title"] = "Activity";
}
<p class="cc-page-kicker">Activity</p>
<h1>Recent activity</h1>
<p class="cc-lead">Wake, sleep, and other storage changes, newest first.</p>
<section class="cc-card">
    @if (Model.Count == 0)
    {
        <p class="cc-empty">Nothing recorded yet.</p>
    }
    else
    {
        <div class="cc-table-wrap">
            <table class="cc-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Kind</th>
                        <th>Who</th>
                        <th>Summary</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var operation in Model)
                {
                    <tr>
                        <td class="cc-mono">@operation.StartedAt.ToString("u")</td>
                        <td>@operation.Kind</td>
                        <td>@operation.Initiator</td>
                        <td>@operation.Summary</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
