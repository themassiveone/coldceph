@using ColdCeph.Control.Features.Integrity.Controllers
@using ColdCeph.Control.Features.StoragePlane.Controllers
@inject StoragePlaneController StoragePlane
@inject IntegrityController Integrity
@{
    var path = Context.Request.Path.Value ?? "/";
    var login = path.StartsWith("/auth", StringComparison.OrdinalIgnoreCase);
    var signedIn = User.Identity?.IsAuthenticated == true;
    var plane = signedIn && !login ? StoragePlane.GetState() : null;
    var integrity = signedIn && !login ? Integrity.GetLastIntegrity() : null;
    string NavClass(string href)
        => href == "/"
            ? (path == "/" ? "cc-nav-link is-current" : "cc-nav-link")
            : path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "cc-nav-link is-current" : "cc-nav-link";
    string Chip(string tone) => tone switch
    {
        "Ready" or "HEALTH_OK" => "cc-chip cc-chip-ok",
        "Waking" or "Quiescing" or "Sleeping" or "HEALTH_WARN" => "cc-chip cc-chip-busy",
        "Faulted" or "HEALTH_ERR" => "cc-chip cc-chip-bad",
        _ => "cc-chip cc-chip-idle"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "ColdCeph")</title>
    <link rel="stylesheet" href="/css/operator.css" />
</head>
<body>
@if (login)
{
    @RenderBody()
}
else
{
    <div class="cc-shell">
        <header class="cc-top">
            <a class="cc-brand" href="/">ColdCeph</a>
            @if (plane is not null && integrity is not null)
            {
                <div class="cc-top-status">
                    <span class="@Chip(plane.State.ToString())"><span class="label">Storage</span> <b>@(plane.State == ColdCeph.Core.Features.StoragePlane.DTOs.StoragePlaneState.Cold ? "Asleep" : plane.State)</b></span>
                    @if (integrity.LastVerifiedCleanAt is not null)
                    {
                        <span class="cc-chip cc-chip-ok"><span class="label">Protection</span> <b>Verified</b></span>
                    }
                    else
                    {
                        <span class="cc-chip cc-chip-idle"><span class="label">Protection</span> <b>Not checked</b></span>
                    }
                </div>
            }
            <div class="cc-top-tools">
                <a class="cc-reload" href="@path">Reload</a>
            </div>
        </header>
        <nav class="cc-rail" aria-label="Operator">
            <a class="@NavClass("/")" href="/">Overview</a>
            <a class="@NavClass("/hosts")" href="/hosts">Storage</a>
            <a class="@NavClass("/operations")" href="/operations">Activity</a>
            <a class="@NavClass("/integrity")" href="/integrity">Data protection</a>
            <div class="cc-nav-section">Advanced</div>
            <a class="@NavClass("/osds")" href="/osds">Storage services</a>
            <a class="@NavClass("/devices")" href="/devices">Disk details</a>
            <a class="@NavClass("/s3")" href="/s3">Backup traffic</a>
            @if (signedIn)
            {
                <form class="cc-rail-foot" method="post" action="/auth/logout">
                    @Html.AntiForgeryToken()
                    <button class="cc-ghost" type="submit">Sign out</button>
                </form>
            }
        </nav>
        <main class="cc-main">
            @RenderBody()
        </main>
    </div>
}
</body>
</html>
